# Copy this file to .env and fill in your own values

# Your MongoDB connection string
# Local example:    mongodb://127.0.0.1:27017/todo-app
# Atlas example:     mongodb+srv://<user>:<password>@cluster.mongodb.net/todo-app
MONGO_URI=mongodb://127.0.0.1:27017/todo-app

# Any long random string, used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Port the backend server will run on
PORT=5000
